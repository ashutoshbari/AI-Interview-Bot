# Application
PROJECT_NAME=AI Interview Bot
VERSION=1.0.0

# Database (update for your own PostgreSQL instance)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_interview

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Frontend URL (for CORS)
NEXT_PUBLIC_API_URL=http://localhost:8000
