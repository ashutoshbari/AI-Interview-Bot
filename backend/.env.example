# Application
PROJECT_NAME=AI Interview Bot
VERSION=1.0.0

# Database
DATABASE_URL=sqlite+aiosqlite:///./ai_interview.db

# Google Gemini AI (get free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Email (Gmail SMTP)
# 1. Use your Gmail address
# 2. Create App Password at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password
MAIL_FROM=your_gmail@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Interviewer notification email
INTERVIEWER_EMAIL=interviewer@yourcompany.com

# Twilio SMS (optional - for SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=your_twilio_phone_number

# Frontend URL (for CORS in production - set to your Vercel URL)
FRONTEND_URL=https://your-app.vercel.app

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
